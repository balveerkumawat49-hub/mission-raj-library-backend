# ============================================================
# Mission Raj Library Backend - Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to source control.
# ============================================================

# Runtime
NODE_ENV=development
PORT=5000

# Database (MongoDB)
# Local example:   mongodb://127.0.0.1:27017/mission_raj_library
# Atlas example:   mongodb+srv://<user>:<pass>@cluster0.mongodb.net/mission_raj_library
DATABASE_URL=mongodb://127.0.0.1:27017/mission_raj_library

# JSON Web Tokens
# Generate strong random secrets, e.g.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# CORS - comma separated list of allowed origins (the frontend's origin(s))
# The frontend defaults to calling http://127.0.0.1:5000, and is normally opened
# straight from disk (origin "null") or from a local static server.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5000,null

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Default owner seed account (used only by `npm run seed:owner`)
# Change these before running the seed script in any shared environment.
SEED_OWNER_NAME=Library Owner
SEED_OWNER_LOGIN_ID=owner@missionraj.test
SEED_OWNER_PASSWORD=ChangeMe@123
